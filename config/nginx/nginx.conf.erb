# Generated by lx. Edit config/nginx/nginx.conf.erb, not runtime/nginx/nginx.conf.
worker_processes 1;
pid <%= runtime_root %>/nginx/nginx.pid;
error_log stderr info;

events {
    worker_connections 256;
}

http {
    default_type application/octet-stream;
    access_log <%= runtime_root %>/logs/nginx-access.log;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    client_max_body_size 10G;
    client_body_timeout 3600s;
    send_timeout 3600s;

    server {
        listen 127.0.0.1:<%= nginx_port %>;
        server_name localhost 127.0.0.1;

        location = /devkit/health {
            access_log off;
            default_type text/plain;
            return 200 "ok\n";
        }

        location /api/ {
            proxy_pass http://127.0.0.1:<%= ruby_port %>;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_request_buffering off;
            proxy_connect_timeout 30s;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # Rails が認可後に返す X-Accel-Redirect だけがこの location へ到達する。
        # Nginx の静的配信に委譲することで Range / 206 / Content-Range を再現する。
        location /internal/storage/drive_items/ {
            internal;
            alias <%= storage_root %>/drive_items/;
            sendfile on;
            tcp_nopush on;
            add_header Accept-Ranges bytes always;
            add_header X-Content-Type-Options nosniff always;
        }

        location / {
            proxy_pass http://127.0.0.1:<%= front_port %>;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }
    }
}
